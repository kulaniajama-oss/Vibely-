name: Build APK
on:
  workflow_dispatch:
  push:
    branches: [main]

env:
  VIBELY_BACKEND_URL: ${{ vars.VIBELY_BACKEND_URL }}
  # Leave VIBELY_TEST_ADS unset (or not "true") = REAL Start.io ads. Set it to true = test ads.
  VIBELY_TEST_ADS: ${{ vars.VIBELY_TEST_ADS }}
  PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
  PIXABAY_API_KEY: ${{ secrets.PIXABAY_API_KEY }}
  VIMEO_ACCESS_TOKEN: ${{ secrets.VIMEO_ACCESS_TOKEN }}

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Unzip project (newest Vibely-*.zip in the repo)
        run: |
          ZIP=$(ls Vibely-*.zip | sort -V | tail -1)
          echo "Using $ZIP"
          unzip -q "$ZIP"
          test -f Vibely/app/build.gradle.kts

      - name: Add Firebase config (optional)
        env:
          GOOGLE_SERVICES_JSON: ${{ secrets.GOOGLE_SERVICES_JSON }}
        run: |
          if [ -n "$GOOGLE_SERVICES_JSON" ]; then
            printf '%s' "$GOOGLE_SERVICES_JSON" > Vibely/app/google-services.json
          fi

      - name: Prepare signing key
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          if [ -n "$KEYSTORE_BASE64" ] && [ -n "$KEYSTORE_PASSWORD" ] && [ -n "$KEY_ALIAS" ] && [ -n "$KEY_PASSWORD" ]; then
            echo "Using your keystore from GitHub secrets."
            printf '%s' "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/vibely.jks"
            echo "VIBELY_KEYSTORE_PASSWORD=$KEYSTORE_PASSWORD" >> "$GITHUB_ENV"
            echo "VIBELY_KEY_ALIAS=$KEY_ALIAS" >> "$GITHUB_ENV"
            echo "VIBELY_KEY_PASSWORD=$KEY_PASSWORD" >> "$GITHUB_ENV"
          else
            echo "No keystore secrets: making a temporary key. The APK installs fine, but its signature changes every run, so uninstall the old Vibely before installing a new one."
            keytool -genkeypair -keystore "$RUNNER_TEMP/vibely.jks" -storepass vibelyci123 -keypass vibelyci123 \
              -alias vibelyci -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Vibely CI"
            echo "VIBELY_KEYSTORE_PASSWORD=vibelyci123" >> "$GITHUB_ENV"
            echo "VIBELY_KEY_ALIAS=vibelyci" >> "$GITHUB_ENV"
            echo "VIBELY_KEY_PASSWORD=vibelyci123" >> "$GITHUB_ENV"
          fi
          echo "VIBELY_KEYSTORE_FILE=$RUNNER_TEMP/vibely.jks" >> "$GITHUB_ENV"

      - name: Build release APK (real ads)
        working-directory: Vibely
        run: |
          export VIBELY_VERSION_CODE=$((100 + GITHUB_RUN_NUMBER))
          gradle :app:assembleRelease

      - uses: actions/upload-artifact@v4
        with:
          name: Vibely-apk
          path: Vibely/app/build/outputs/apk/release/*.apk
          if-no-files-found: error
